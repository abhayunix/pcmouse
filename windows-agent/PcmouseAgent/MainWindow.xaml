<Window x:Class="PcmouseAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Mouse Agent - Remote PC Controller" Height="680" Width="960"
        WindowStartupLocation="CenterScreen" Background="#121212">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="PC Mouse Agent" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <TextBlock Text=" v1.0.0" FontSize="14" Foreground="#888888" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
            </StackPanel>
            <Button Content="Refresh Pairing Code" Click="RefreshPairing_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Background="#00E5FF" Foreground="#000000" FontWeight="Bold" Padding="12,6" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Status & System Telemetry Panel -->
            <StackPanel Grid.Column="0">
                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Agent Connection Status" FontSize="16" FontWeight="SemiBold" Foreground="#00E5FF" Margin="0,0,0,10"/>
                        <TextBlock x:Name="StatusText" Text="Status: Disconnected / Ready" FontSize="14" Foreground="#FFB74D" Margin="0,0,0,6"/>
                        <TextBlock x:Name="LocalIpText" Text="Local IP: Listening on 0.0.0.0:8443" FontSize="13" Foreground="#B0B0B0" Margin="0,0,0,4"/>
                        <TextBlock x:Name="BluetoothText" Text="Bluetooth Classic: RFCOMM Listener Enabled" FontSize="13" Foreground="#B0B0B0"/>
                    </StackPanel>
                </Border>

                <!-- Hardware Telemetry -->
                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Live System Metrics" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="CpuText" Grid.Row="0" Grid.Column="0" Text="CPU: 0.0%" Foreground="#80D8FF" Margin="0,2,0,6" FontSize="13"/>
                            <TextBlock x:Name="RamText" Grid.Row="0" Grid.Column="1" Text="RAM: 0 MB / 0 MB" Foreground="#B388FF" Margin="0,2,0,6" FontSize="13"/>
                            <TextBlock x:Name="BatteryText" Grid.Row="1" Grid.Column="0" Text="Battery: 100%" Foreground="#A7FFEB" Margin="0,2,0,2" FontSize="13"/>
                            <TextBlock x:Name="UptimeText" Grid.Row="1" Grid.Column="1" Text="Uptime: 0d 0h 0m" Foreground="#FFE082" Margin="0,2,0,2" FontSize="13"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Audit Log Box -->
                <Border Background="#1E1E1E" CornerRadius="8" Padding="15" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="Connection Audit Log" FontSize="14" FontWeight="SemiBold" Foreground="#A0A0A0" Margin="0,0,0,8"/>
                        <ListBox x:Name="AuditLogListBox" Height="150" Background="#121212" Foreground="#80D8FF" BorderThickness="0" FontSize="11"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Pairing Panel -->
            <Border Grid.Column="2" Background="#252526" CornerRadius="8" Padding="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Pair Mobile Device" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <Border Background="#FFFFFF" Padding="10" CornerRadius="8" Margin="0,0,0,15">
                        <Image x:Name="QrCodeImage" Width="220" Height="220"/>
                    </Border>
                    <TextBlock x:Name="PairingCodeText" Text="Pairing PIN: ------" FontSize="18" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Scan this QR code from the Android Remote PC app to authorize connection."
                               FontSize="12" Foreground="#888888" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Text="PC Mouse Agent runs in your interactive Windows desktop session. Authorization required for all commands."
                   FontSize="12" Foreground="#666666" HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </Grid>
</Window>
