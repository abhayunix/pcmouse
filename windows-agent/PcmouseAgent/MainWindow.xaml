<Window x:Class="PcmouseAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pcmouse Agent - Precise. Connected." Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#0D1117">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Viewbox Width="46" Height="46" Margin="0,0,14,0">
                    <Canvas Width="100" Height="100">
                        <!-- Mouse Outer Shell -->
                        <Path Data="M 35 15 C 50 5, 75 15, 80 35 C 85 55, 65 80, 45 80 C 25 80, 15 60, 20 40 C 25 25, 25 20, 35 15 Z"
                              Stroke="#00E5FF" StrokeThickness="5" Fill="#161B22"/>
                        <!-- Mouse Scroll Wheel -->
                        <Rectangle Canvas.Left="48" Canvas.Top="22" Width="8" Height="16" RadiusX="4" RadiusY="4" Fill="#00E5FF"/>
                        <!-- Mouse Cable forming 'pc' curve -->
                        <Path Data="M 52 38 C 52 50, 42 65, 32 75 C 25 82, 30 92, 42 92 C 55 92, 60 80, 52 70"
                              Stroke="#00B0FF" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="pc" FontSize="28" FontWeight="ExtraBold" Foreground="#00E5FF"/>
                        <TextBlock Text="mouse" FontSize="28" FontWeight="Bold" Foreground="#00B0FF"/>
                        <Border Background="#1F2937" CornerRadius="4" Padding="6,2" Margin="10,2,0,2" VerticalAlignment="Center">
                            <TextBlock Text="v1.0 Agent" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="PRECISE. CONNECTED." FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="2,-2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Content="Refresh Pairing Code" Click="RefreshPairing_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Background="#00E5FF" Foreground="#000000" FontSize="13" FontWeight="Bold" Padding="16,8" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </DockPanel>

        <!-- Main Body Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Status & System Telemetry Panel -->
            <StackPanel Grid.Column="0">
                <!-- Agent Connection Status -->
                <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Agent Connection Status" FontSize="15" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,12"/>
                        <TextBlock x:Name="StatusText" Text="Status: Disconnected / Ready" FontSize="15" FontWeight="SemiBold" Foreground="#FFB74D" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LocalIpText" Text="Local IP: Listening on 0.0.0.0:8443" FontSize="13" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                        <TextBlock x:Name="BluetoothText" Text="Bluetooth Classic: RFCOMM Listener Enabled" FontSize="13" Foreground="#9CA3AF"/>
                    </StackPanel>
                </Border>

                <!-- Hardware Telemetry -->
                <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Live System Telemetry" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="CpuText" Grid.Row="0" Grid.Column="0" Text="CPU: 0.0%" Foreground="#80D8FF" Margin="0,4,0,8" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RamText" Grid.Row="0" Grid.Column="1" Text="RAM: 0 MB / 0 MB" Foreground="#B388FF" Margin="0,4,0,8" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BatteryText" Grid.Row="1" Grid.Column="0" Text="Battery: 100%" Foreground="#A7FFEB" Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UptimeText" Grid.Row="1" Grid.Column="1" Text="Uptime: 0d 0h 0m" Foreground="#FFE082" Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Audit Log Box -->
                <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="1.5" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Connection Audit Log" FontSize="14" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                        <ListBox x:Name="AuditLogListBox" Height="140" Background="#0D1117" Foreground="#80D8FF" BorderThickness="0" FontSize="11" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Pairing Panel -->
            <Border Grid.Column="2" Background="#161B22" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="12" Padding="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Pair Mobile Device" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Border Background="#FFFFFF" Padding="12" CornerRadius="10" Margin="0,0,0,18">
                        <Image x:Name="QrCodeImage" Width="220" Height="220"/>
                    </Border>
                    <TextBlock x:Name="PairingCodeText" Text="Pairing PIN: ------" FontSize="18" FontWeight="ExtraBold" Foreground="#00E5FF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Scan this QR code from pcmouse Android Remote App to pair and control this PC."
                               FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <TextBlock Grid.Row="2" Text="pcmouse Windows Agent runs in your active desktop session. Secure authorization required."
                   FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </Grid>
</Window>
